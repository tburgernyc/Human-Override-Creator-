# ============================================
# Human Override Creator — Environment Config
# ============================================
# Copy this file to `.env` and fill in your values.

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (optional)
# - Railway / Heroku / Cloud Run set $PORT automatically — leave this unset there.
# - Locally, defaults to 3001 so the Vite dev server on 3000 can proxy through.
# PORT=3001

# Allowed CORS origins for the API in production (comma-separated).
# In dev (NODE_ENV != production) localhost:3000 is always allowed.
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Frontend → backend proxy URL (REQUIRED in dev).
# In production, the SPA and the API are served from the same Express origin,
# so services/gemini.ts falls back to `${window.location.origin}/api/gemini`
# and this var can stay unset.
# In dev with `npm run dev:all`, the Vite server on :3000 has no proxy rule
# for /api/*, so the SDK's requests to /api/gemini/... 404 at Vite's level
# unless this var sends them directly to the Express proxy on :3001.
VITE_PROXY_URL=http://localhost:3001/api/gemini
